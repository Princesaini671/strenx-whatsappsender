{
  "name": "strenx-whatsapp-sender",
  "private": true,
  "version": "1.0.0",
  "description": "Strenx WhatsApp Sender - Windows Desktop Messaging Software",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron release",
    "lint": "tsc --noEmit",
    "build:electron": "npm run build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "dist:win": "npm run build:electron && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "papaparse": "^5.7.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
